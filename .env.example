# OpenAI API 키 (https://platform.openai.com/api-keys)
# Vercel: 대시보드에 OPENAI_API_KEY 만 넣어도 됩니다(서버리스 + 빌드 시 버튼 활성).
# 아래 둘 중 하나만 있어도 됩니다. 로컬은 Vite 프록시가 서버에서 읽습니다.
# VITE_OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# 브라우저 CORS 회피를 위해 Vite 개발/프리뷰 서버가 프록시로 전달합니다.
# 키를 바꾼 뒤에는 npm run dev 를 다시 실행하세요.
VITE_OPENAI_API_KEY=sk-...
# 선택. 기본값 gpt-4o-mini
# VITE_OPENAI_MODEL=gpt-4o-mini
# TTS (audio/speech). 선택 — 기본 tts-1 / nova
# VITE_OPENAI_TTS_MODEL=tts-1
# VITE_OPENAI_TTS_VOICE=nova
